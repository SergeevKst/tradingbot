{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "market": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "timeframe": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 16
            },
            {
              "type": "null"
            }
          ]
        },
        "lastPrice": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bid": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "ask": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "candles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "startTime": {
                "type": "number"
              },
              "open": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "high": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "low": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "close": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "volume": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "startTime",
              "open",
              "high",
              "low",
              "close",
              "volume"
            ]
          },
          "maxItems": 100
        },
        "indicators": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  "value": {
                    "type": "number"
                  }
                },
                "required": [
                  "name",
                  "value"
                ]
              },
              "maxItems": 32
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "symbol",
        "timeframe",
        "lastPrice",
        "bid",
        "ask",
        "candles",
        "indicators"
      ]
    },
    "position": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "symbol": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "side": {
              "type": "string",
              "enum": [
                "LONG",
                "SHORT"
              ]
            },
            "entryPrice": {
              "type": "number",
              "minimum": 0
            },
            "markPrice": {
              "type": "number",
              "minimum": 0
            },
            "unrealizedPnlUsd": {
              "type": "number"
            },
            "stopLossPrice": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "takeProfitPrice": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "symbol",
            "side",
            "entryPrice",
            "markPrice",
            "unrealizedPnlUsd",
            "stopLossPrice",
            "takeProfitPrice"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "market",
    "position"
  ]
}
