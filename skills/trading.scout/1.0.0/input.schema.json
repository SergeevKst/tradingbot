{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "news": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "lastPrice": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "bid": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "ask": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "high24h": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "low24h": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "avgRange14h": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "candles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "o": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "h": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "l": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "c": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "v": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "o",
                "h",
                "l",
                "c",
                "v"
              ]
            },
            "maxItems": 30
          }
        },
        "required": [
          "symbol",
          "lastPrice",
          "bid",
          "ask",
          "high24h",
          "low24h",
          "avgRange14h",
          "candles"
        ]
      },
      "maxItems": 20
    },
    "openPositions": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "side": {
                "type": "string",
                "enum": [
                  "LONG",
                  "SHORT"
                ]
              }
            },
            "required": [
              "symbol",
              "side"
            ]
          },
          "maxItems": 20
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "news",
    "symbols",
    "openPositions"
  ]
}
