{
  "$comment": "Curated subset of the official Bybit MCP server tool set (382 -> ~40). Allowlist mode: only tools matching `allow` AND not matching `deny` are exposed to the model. Glob: * and ? are supported. Keep this list small — every exposed tool costs its full schema in every model request.",
  "allow": [
    "getServerTime",
    "getInstrumentsInfo",
    "getTickers",
    "getOrderbook",
    "getMarketKline",
    "getMarkPriceKline",
    "getRecentPublicTrades",
    "getFundingRateHistory",
    "getOpenInterest",
    "getLongShortRatio",
    "getRiskLimit",
    "getOrderPriceLimit",

    "getAccountInfo",
    "getWalletBalance",
    "getFeeRate",
    "getTransactionLog",
    "getClosedPnl",
    "getUserSettingConfig",

    "getPositionInfo",
    "getPositionSymbolInfo",
    "setLeverage",
    "setTradingStop",
    "setAutoAddMargin",
    "switchPositionMode",
    "setMarginMode",

    "createOrder",
    "batchCreateOrders",
    "amendOrder",
    "batchAmendOrders",
    "cancelOrder",
    "batchCancelOrders",
    "cancelAllOrders",
    "getOpenOrders",
    "getOrderHistory",
    "preCheckOrder",

    "getDcpInfo",
    "setDcp",
    "getSmpGroup"
  ],
  "deny": [
    "*Withdraw*",
    "*Transfer*",
    "*Deposit*",
    "*Borrow*",
    "*Repay*",
    "*Loan*",
    "*Earn*",
    "*Copy*",
    "*Prediction*",
    "*Card*",
    "*P2P*",
    "getAds",
    "getMyAds",
    "getMyAdDetails",
    "postAd",
    "updateAd",
    "removeAd",
    "ws*",
    "subscribe*",
    "*Subscription*"
  ]
}
