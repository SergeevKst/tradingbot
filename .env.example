# ---------------------------------------------------------------------------
# Bybit Trading Bot — example environment file.
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every value below is a safe placeholder, not a working credential.
# ---------------------------------------------------------------------------

# --- Bybit credentials -----------------------------------------------------
# Required only for exchange I/O (market data / later stages).
# Stage 1 runs entirely offline and does not need these.
# Use a key WITHOUT withdrawal permission and WITH an IP whitelist.
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# true = api-testnet.bybit.com, false = api.bybit.com
BYBIT_TESTNET=false

# --- Trading mode ----------------------------------------------------------
# BACKTEST | PAPER | LIVE
# PAPER is the default when unset.
TRADING_MODE=PAPER

# Live execution is NOT implemented in Stage 1. Setting TRADING_MODE=LIVE
# aborts startup even with this flag enabled — the flag exists so the refusal
# is explicit rather than incidental.
ALLOW_LIVE_TRADING=false

# --- Risk limits (conservative TEST profile, not an optimum) ---------------
# These are hard limits. Nothing at runtime — no prompt, proposal or argument —
# may widen them.

# Fallback equity for offline runs only; live equity always overrides it.
RISK_INITIAL_CAPITAL_USD=340

# Hard cap on position notional / equity.
RISK_MAX_LEVERAGE=2

# ISOLATED | CROSS. Stage 1 never applies this to the exchange.
RISK_MARGIN_MODE=ISOLATED

# Stage 1 never applies this to the exchange.
RISK_AUTO_ADD_MARGIN=false

# Percent of equity risked if the stop loss is hit.
RISK_PER_TRADE_PCT=0.5

# Percent of equity loss that halts new trades for the day.
RISK_MAX_DAILY_LOSS_PCT=2.0

# Maximum concurrent positions.
RISK_MAX_OPEN_POSITIONS=2

# Maximum approved trades per day.
RISK_MAX_TRADES_PER_DAY=10

# Refuse proposals without protective orders.
RISK_REQUIRE_STOP_LOSS=true
RISK_REQUIRE_TAKE_PROFIT=true

# Minimum reward/risk ratio.
RISK_MIN_RISK_REWARD=1.5

# Smallest position notional worth opening (USD).
RISK_MIN_POSITION_NOTIONAL_USD=5

# --- Logging ---------------------------------------------------------------
# SILENT | ERROR | WARN | INFO | DEBUG
# Secrets are redacted at every level.
LOG_LEVEL=INFO

# --- PAPER trading (Stage 2) ----------------------------------------------
# PAPER mode requires NO API keys: market data is public and the account is
# local. Leave BYBIT_API_KEY / BYBIT_API_SECRET unset for paper work.

# Starting simulated equity lives in RISK_INITIAL_CAPITAL_USD (see the risk
# limits above) — deliberately NOT duplicated here, so one variable is the
# single source of truth.

# Instrument the PAPER bootstrap inspects first.
PAPER_SYMBOL=BTCUSDT

# Where the simulated account and its journal live.
PAPER_STATE_FILE=data/paper/paper-state.json
PAPER_JOURNAL_FILE=data/paper/journal.jsonl

# Set to false to run entirely in memory (nothing is written to disk).
# NOTE: with PAPER_PERSIST=false the account does NOT survive a restart.
PAPER_PERSIST=true

# Session timezone for the daily counters. UTC only in this stage.
PAPER_TIMEZONE=UTC

# --- Simulated fees --------------------------------------------------------
# These are SYNTHETIC PLACEHOLDERS for the paper simulation, NOT Bybit's real
# schedule. They are deliberately pessimistic. A later stage will read real
# rates from exchange/account data.
PAPER_TAKER_FEE_RATE=0.001
PAPER_EXIT_FEE_RATE=0.001

# --- Market data -----------------------------------------------------------
# Only "linear" (USDT perpetual) is supported in this stage.
MARKET_CATEGORY=linear
MARKET_DEFAULT_INTERVAL=15
MARKET_DEFAULT_CANDLE_LIMIT=200
MARKET_REQUEST_TIMEOUT_MS=15000
